# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to GitHub — add it to .gitignore.

ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medrep_ai

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=
GEMINI_API_KEY=
FRONTEND_ORIGINS=["http://localhost:5173"]
